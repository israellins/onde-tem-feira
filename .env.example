# Copie para .env.local e preencha. NUNCA faça commit do .env.local.

# Supabase (Project Settings → API). A chave "anon"/"publishable" é pública
# por design; a segurança vem das regras RLS do banco.
# Sem estas duas variáveis o app funciona em modo offline: mapa com os dados
# embutidos e lista de compras no aparelho, sem login/mural/sugestões.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Endereço público do site (usado em links de compartilhamento/SEO).
NEXT_PUBLIC_SITE_URL=https://seu-dominio.vercel.app

# E-mail exibido na política de privacidade para pedidos de dados/exclusão.
NEXT_PUBLIC_CONTACT_EMAIL=
