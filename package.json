{
  "name": "onde-tem-feira",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:db": "node scripts/with-local-supabase.mjs vitest run tests/integration",
    "test:e2e": "node scripts/with-local-supabase.mjs playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts && prettier --write src/lib/supabase/database.types.ts",
    "db:gerar-carga": "node scripts/generate-feiras-migration.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "leaflet": "^1.9.4",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.3"
  },
  "description": "Mapa colaborativo de feiras livres no Brasil",
  "engines": {
    "node": ">=20.9"
  }
}
